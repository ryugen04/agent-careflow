{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "agent-careflow hook claude post-tool-use --on-missing-context warn",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash|Write|Edit|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "agent-careflow hook claude pre-tool-use --on-missing-context hybrid --incident-on-deny",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash|Write|Edit|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "agent-careflow hook claude session-start",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "agent-careflow hook claude stop --incident-on-deny",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "agent-careflow hook claude subagent-start",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "agent-careflow hook claude subagent-stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
